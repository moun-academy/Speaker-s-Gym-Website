{
  "redirects": [
    {
      "source": "/pitch-v2",
      "destination": "/pitch",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/pitch",
      "destination": "/pitch/index.html"
    },
    {
      "source": "/pitch/call",
      "destination": "/pitch/call.html"
    },
    {
      "source": "/links",
      "destination": "/links/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
