# Server-side password for the waiting list admin endpoint (the /private page no longer needs a password)
SPEAKERS_GYM_SALES_PASSWORD=

# Server-only Meta Conversions API configuration
META_CONVERSIONS_API_TOKEN=
META_GRAPH_API_VERSION=v26.0

# Temporary. Set only while validating events in Meta Test Events.
META_TEST_EVENT_CODE=

# Waiting list on /sales: the Google Apps Script web app URL that writes to the Group Waitlist tab
WAITLIST_SHEET_URL

# Stripe Checkout (embedded form). Keys: https://dashboard.stripe.com/test/apikeys
# Browser-accessible variables must be prefixed with VITE_.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Server-only (no VITE_ prefix)
STRIPE_SECRET_KEY=sk_test_...

# Stripe Price IDs for the /europe embedded form (one-time EUR prices)
STRIPE_PRICE_EU_ONE_ON_ONE=
STRIPE_PRICE_EU_GROUP=
STRIPE_PRICE_EU_EARLY_BIRD=

# Stripe webhook signing secret (Stripe Dashboard > Developers > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...
